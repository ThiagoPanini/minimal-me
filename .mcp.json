{
  "mcpServers": {
    "hostinger": {
      "type": "http",
      "url": "https://mcp.hostinger.com"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "coolify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@masonator/coolify-mcp@3.10.1"],
      "env": {
        "COOLIFY_BASE_URL": "https://vps.panlabs.tech",
        "COOLIFY_ACCESS_TOKEN": "${COOLIFY_ACCESS_TOKEN}"
      }
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"]
    }
  }
}
