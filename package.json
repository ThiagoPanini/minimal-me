{
  "name": "minimal-me",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "author-setup": "node scripts/author-setup/main.mjs",
    "check": "biome ci && pnpm test:scripts && pnpm --filter web check:types",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "pnpm --filter web test:e2e",
    "verify": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4"
  }
}
